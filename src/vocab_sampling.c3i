// vocab_sampling.c3i
// Vocab queries, Tokenization, Chat templates, and the start of the
// Sampling API (the llama_sampler_i interface struct, llama_sampler /
// llama_sampler_data, and the generic sampler + sampler-chain functions)
// for the llama C3 bindings. The concrete sampler constructors
// (llama_sampler_init_greedy and friends) belong to sampler_init.c3i.
//
// Source: include/llama.h (see ../reference/llama.h), lines 1203-1474 of
// https://github.com/ggml-org/llama.cpp, plus llama_sampler_sample (line 1652).
module llama;

// --- Vocab ---

